{
    "baseUrl": "https://forzys.github.io/gistbit-mini",
    "groups": [
        {
            "id": "ai",
            "title": {
                "zh": "AI",
                "en": "AI",
                "ko": "AI",
                "ja": "AI",
                "es": "IA",
                "de": "KI",
                "fr": "IA"
            }
        },
        {
            "id": "learn",
            "title": {
                "zh": "学习",
                "en": "Learn",
                "ko": "학습",
                "ja": "学習",
                "es": "Aprender",
                "de": "Lernen",
                "fr": "Apprendre"
            }
        }
    ],
    "tools": [
        {
            "dev": true,
            "type": "prompt",
            "group": "ai",
            "id": "summarize-points",
            "icon": "list.bullet.rectangle",
            "input": "item",
            "output": "note",
            "title": {
                "zh": "整理要点",
                "en": "Key Points",
                "ko": "핵심 정리",
                "ja": "要点まとめ",
                "es": "Puntos clave",
                "de": "Kernpunkte",
                "fr": "Points clés"
            },
            "subtitle": {
                "zh": "资料整理成要点笔记",
                "en": "Turn an item into a note of key points",
                "ko": "자료를 핵심 노트로 정리",
                "ja": "資料を要点ノートにまとめる",
                "es": "Convierte un material en una nota de puntos clave",
                "de": "Material als Notiz mit Kernpunkten",
                "fr": "Transforme un document en note de points clés"
            },
            "prompt": "把下面的资料整理成 5 到 8 条要点。每条一句话，按原文的顺序排列，不要加原文没有的内容。用{{language}}写。\n{{input}}"
        },
        {
            "dev": true,
            "type": "prompt",
            "group": "ai",
            "id": "make-quiz",
            "icon": "checklist",
            "input": "item",
            "output": "text",
            "title": {
                "zh": "出几道题",
                "en": "Make a Quiz",
                "ko": "퀴즈 만들기",
                "ja": "問題を作る",
                "es": "Crear un test",
                "de": "Quiz erstellen",
                "fr": "Créer un quiz"
            },
            "subtitle": {
                "zh": "根据资料出选择题",
                "en": "Multiple-choice questions from an item",
                "ko": "자료로 객관식 문제 만들기",
                "ja": "資料から選択問題を作る",
                "es": "Preguntas tipo test a partir de un material",
                "de": "Multiple-Choice-Fragen aus einem Material",
                "fr": "QCM à partir d'un document"
            },
            "prompt": "根据下面的资料出 5 道单选题。每题 4 个选项（A–D），只有一个正确；每题后面写出正确答案和一句话解析。题目只考资料里有的内容。用{{language}}写。\n{{input}}"
        },
        {
            "dev": true,
            "type": "prompt",
            "group": "ai",
            "id": "explain-concept",
            "icon": "lightbulb",
            "input": "text",
            "output": "text",
            "title": {
                "zh": "解释概念",
                "en": "Explain a Concept",
                "ko": "개념 설명",
                "ja": "概念を説明",
                "es": "Explicar un concepto",
                "de": "Begriff erklären",
                "fr": "Expliquer un concept"
            },
            "subtitle": {
                "zh": "通俗解释 + 例子",
                "en": "Plain explanation with an example",
                "ko": "쉬운 설명과 예시",
                "ja": "わかりやすい説明と例",
                "es": "Explicación sencilla con un ejemplo",
                "de": "Einfache Erklärung mit Beispiel",
                "fr": "Explication simple avec un exemple"
            },
            "prompt": "用通俗易懂的话解释下面的概念：先用一句话给出定义，再举一个生活中的例子，最后指出一个常见的误解。用{{language}}回答。\n{{input}}"
        },
        {
            "dev": true,
            "type": "prompt",
            "group": "ai",
            "id": "polish-email",
            "icon": "envelope",
            "input": "text",
            "output": "text",
            "title": {
                "zh": "邮件润色",
                "en": "Polish Email",
                "ko": "이메일 다듬기",
                "ja": "メールを整える",
                "es": "Pulir correo",
                "de": "E-Mail verfeinern",
                "fr": "Peaufiner un e-mail"
            },
            "subtitle": {
                "zh": "改成礼貌、简洁的邮件",
                "en": "Rewrite as a polite, concise email",
                "ko": "정중하고 간결한 이메일로",
                "ja": "丁寧で簡潔なメールに書き直す",
                "es": "Reescribir como un correo cortés y conciso",
                "de": "Als höfliche, knappe E-Mail umschreiben",
                "fr": "Réécrire en e-mail poli et concis"
            },
            "prompt": "把下面的内容改写成一封礼貌、简洁的邮件，保留所有关键信息，不要编造内容。只输出邮件正文。用{{language}}写。\n{{input}}"
        },
        {
            "dev": true,
            "type": "prompt",
            "group": "ai",
            "id": "extract-vocab",
            "icon": "character.book.closed",
            "input": "item",
            "output": "vocab",
            "title": {
                "zh": "提取生词",
                "en": "Extract Vocabulary",
                "ko": "단어 추출",
                "ja": "単語を抽出",
                "es": "Extraer vocabulario",
                "de": "Vokabeln extrahieren",
                "fr": "Extraire le vocabulaire"
            },
            "subtitle": {
                "zh": "挑出值得学的词加进生词本",
                "en": "Add useful words to vocabulary",
                "ko": "배울 만한 단어를 단어장에 추가",
                "ja": "覚えたい単語を単語帳に追加",
                "es": "Añade palabras útiles al vocabulario",
                "de": "Nützliche Wörter ins Vokabular",
                "fr": "Ajoute les mots utiles au vocabulaire"
            },
            "prompt": "从下面的内容里挑出最值得学习的单词和短语，不超过 15 个，跳过人名、地名和最常见的基础词。释义用{{language}}，简短。\n{{input}}"
        },
        {
            "dev": true,
            "type": "prompt",
            "group": "ai",
            "id": "photo-question",
            "icon": "camera.viewfinder",
            "input": "image",
            "output": "text",
            "title": {
                "zh": "拍题讲解",
                "en": "Explain a Problem",
                "ko": "문제 풀이",
                "ja": "問題を解説",
                "es": "Explicar un ejercicio",
                "de": "Aufgabe erklären",
                "fr": "Expliquer un exercice"
            },
            "subtitle": {
                "zh": "拍一道题，讲解题思路",
                "en": "Snap a problem, get the steps",
                "ko": "문제를 찍으면 풀이 과정을 설명",
                "ja": "問題を撮ると解き方を説明",
                "es": "Haz una foto y obtén los pasos",
                "de": "Foto machen, Lösungsweg erhalten",
                "fr": "Prenez une photo, obtenez les étapes"
            },
            "prompt": "下面是一道题目（从照片里识别出的文字，可能有个别识别错误，请按上下文理解）。先说明这道题考什么，再一步一步写出解题过程，最后单独一行写出答案。用{{language}}回答。\n{{input}}"
        },
        {
            "dev": true,
            "id": "english-podcasts",
            "type": "feeds",
            "group": "learn",
            "icon": "headphones",
            "title": {
                "zh": "英语学习播客",
                "en": "English Learning Podcasts",
                "ko": "영어 학습 팟캐스트",
                "ja": "英語学習ポッドキャスト",
                "es": "Pódcasts para aprender inglés",
                "de": "Podcasts zum Englischlernen",
                "fr": "Podcasts pour apprendre l'anglais"
            },
            "description": {
                "zh": "适合练听力的英语播客：BBC 6 Minute English、BBC Learning English Conversations、All Ears English、Luke's English Podcast。",
                "en": "English podcasts for listening practice: BBC 6 Minute English, BBC Learning English Conversations, All Ears English, Luke's English Podcast.",
                "ko": "듣기 연습에 좋은 영어 팟캐스트: BBC 6 Minute English, BBC Learning English Conversations, All Ears English, Luke's English Podcast.",
                "ja": "リスニング練習に向いた英語ポッドキャスト：BBC 6 Minute English、BBC Learning English Conversations、All Ears English、Luke's English Podcast。",
                "es": "Pódcasts en inglés para practicar la comprensión auditiva: BBC 6 Minute English, BBC Learning English Conversations, All Ears English, Luke's English Podcast.",
                "de": "Englische Podcasts fürs Hörverstehen: BBC 6 Minute English, BBC Learning English Conversations, All Ears English, Luke's English Podcast.",
                "fr": "Podcasts en anglais pour s'entraîner à l'écoute : BBC 6 Minute English, BBC Learning English Conversations, All Ears English, Luke's English Podcast."
            },
            "language": "en-US",
            "feeds": [
                {
                    "url": "https://podcasts.files.bbci.co.uk/p02pc9tn.rss"
                },
                {
                    "url": "https://podcasts.files.bbci.co.uk/p02pc9zn.rss"
                },
                {
                    "url": "https://feeds.megaphone.fm/allearsenglish"
                },
                {
                    "url": "https://teacherluke.libsyn.com/rss"
                }
            ]
        },
        {
            "dev": true,
            "id": "hello",
            "type": "mini",
            "group": "learn",
            "source": "minis/hello"
        },
        {
            "dev": true,
            "id": "sample-wordbook",
            "type": "pack",
            "group": "learn",
            "source": "packs/sample-wordbook.json",
            "title": {
                "zh": "生物学词汇（示例）",
                "en": "Biology Words (Sample)"
            },
            "description": {
                "zh": "12 个高中生物常用词，测试下载的词书用。",
                "en": "12 common biology words for testing downloaded wordbooks."
            }
        },
        {
            "dev": true,
            "id": "sample-terms",
            "type": "pack",
            "group": "learn",
            "source": "packs/sample-terms.json",
            "title": {
                "zh": "技术术语（示例）",
                "en": "Tech Terms (Sample)"
            },
            "description": {
                "zh": "5 个常被识别错的技术名词，测试术语导入用。",
                "en": "5 tech terms often misrecognized, for testing term import."
            }
        },
        {
            "dev": true,
            "id": "periodic-table",
            "type": "mini",
            "group": "learn",
            "source": "minis/periodic-table"
        }
    ]
}
